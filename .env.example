# ── GiveawayHub environment ──
# Server
PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string

# ── AUTH MODE ─────────────────────────────────────────────────────────────
# If X_CLIENT_ID is EMPTY → mock auth (no API keys needed, for demo/local).
# To go LIVE, fill these in AND set X_CLIENT_ID / DC_CLIENT_ID.
#
# X follower verification mode (X_VERIFY_MODE):
#   honor  (default) — user's connected X username counts as followed. Instant & 100% free.
#   scrape           — verify via twscrape using our own scraping account(s). Free but rate-limited.
#   xapi             — real X API v2 (PAID ~$100/mo, follows.read) for real verif at scale.
X_VERIFY_MODE=honor
# twscrape scraping accounts (used when X_VERIFY_MODE=scrape)
TWSCRAPE_VENV=/home/ubuntu/x_intel_bot/venv/bin/python
TWSCRAPE_DB=/home/ubuntu/x_intel_bot/accounts.db
SCRAPE_LIMIT=8000
#
# X (Twitter) OAuth2 App — for connecting user accounts:
#   https://developer.x.com/en/portal → create app → User auth settings
#   App type: Web / OAuth2.0 PKCE
#   Redirect URI:  {BASE_URL}/auth/x/callback
#   Scopes needed: tweet.read users.read follows.read offline.access
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=

# Discord OAuth2 App:
#   https://discord.com/developers/applications → OAuth2 → Redirects
#   Redirect URI: {BASE_URL}/auth/dc/callback
#   Scopes: identify guilds
DC_CLIENT_ID=
DC_CLIENT_SECRET=
DC_REDIRECT_URI=
